# HYBRID FIT - Environment Configuration for Local and Render

# Port assigned by Render or local environment (default: 3000)
PORT=3000

# Your Public Render URL (e.g. https://hybrid-fit-app.onrender.com) or http://localhost:3000
APP_URL=http://localhost:3000

# Strava API Credentials (Get from https://www.strava.com/settings/api)
STRAVA_CLIENT_ID=your_strava_client_id_here
STRAVA_CLIENT_SECRET=your_strava_client_secret_here
